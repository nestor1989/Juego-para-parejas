<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pass_gradient"
    tools:context=".jugadorDos">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline36"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.80" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gButtonBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.89" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gLinkBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.94" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/guideline36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="28dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="78dp"
                android:src="@drawable/ic_heart_duo"
                android:contentDescription="@null" />

            <FrameLayout
                android:id="@+id/eyeBadge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_badge_translucent">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_eye_off"
                    app:tint="@color/white"
                    android:contentDescription="@string/pass_phone_caption" />
            </FrameLayout>

            <TextView
                android:id="@+id/turnoView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:fontFamily="@font/roboto_slab"
                android:gravity="center_horizontal"
                android:text="@string/placeholder_turn"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:fontFamily="@font/roboto_slab"
                android:gravity="center_horizontal"
                android:text="@string/player_two_instruction"
                android:textAlignment="center"
                android:textColor="#FFE3EC"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_pill_outline_light"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:alpha="0.55">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/white" />

                    <View
                        android:layout_width="160dp"
                        android:layout_height="7dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/white" />

                    <View
                        android:layout_width="190dp"
                        android:layout_height="7dp"
                        android:background="@color/white" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/pass_phone_hidden_hint"
                    android:textColor="#FFE3EC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/ctaRing1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_pill_outline_light"
        app:layout_constraintBottom_toTopOf="@id/gButtonBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline36" />

    <View
        android:id="@+id/ctaRing2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_pill_outline_light"
        app:layout_constraintBottom_toTopOf="@id/gButtonBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline36" />

    <Button
        android:id="@+id/empiezaBoton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_button_white_pill"
        android:elevation="6dp"
        android:fontFamily="@font/roboto_slab"
        android:text="@string/button_start_test"
        android:textColor="@color/pink_dark"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/gButtonBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline36" />

    <TextView
        android:id="@+id/howToPlayLink"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/how_to_play"
        android:textColor="@color/white"
        android:textSize="12.5sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/gLinkBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/gButtonBottom" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        ads:adSize="LARGE_BANNER"
        ads:adUnitId="ca-app-pub-4930505659937183/9156906038"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toTopOf="@id/gLinkBottom" />

</androidx.constraintlayout.widget.ConstraintLayout>
