# Reglas para la versión 4.0 (R8 activado en release).
# Billing, AdMob, UMP, Install Referrer, Play Review y Firebase traen sus propias
# reglas de consumidor; no hace falta agregar nada para ellos.

# Mantener números de línea legibles en los reportes de Crashlytics.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile
